<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
    The payroll chain, in `payroll`'s own category so the user form shows ONE
    selector with four levels (Odoo 18 renders a category as a selection only
    when its groups are totally ordered by implication):

      Reader (audit) < Preparer < Approver < Administrator

    Approver and Administrator are `payroll.group_payroll_user` and
    `payroll.group_payroll_manager`, re-used rather than replaced so every
    third-party ACL and menu pointing at them keeps working. Their renaming and
    the cut of the contracts implication live in hooks.py: they are noupdate
    records of `payroll`, which XML only reaches at install time.
  -->
    <record id="group_payroll_reader" model="res.groups">
        <field name="name">Reader (audit)</field>
        <field name="category_id" ref="payroll.module_category_payroll" />
        <!-- No hr.group_hr_user on purpose: it would give write access to every
         employee file, bank account included. Employees are read through
         this module's own ACL instead. -->
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        <field
            name="comment"
        >Sees the payslips, batches and payroll reports of their companies. Changes nothing.</field>
    </record>

    <record id="group_payroll_preparer" model="res.groups">
        <field name="name">Preparer</field>
        <field name="category_id" ref="payroll.module_category_payroll" />
        <!-- HR officer, as the stock Officer was: computing reads employee fields
         declared groups="hr.group_hr_user". -->
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_payroll_reader')), Command.link(ref('hr.group_hr_user'))]"
        />
        <field
            name="comment"
        >Builds batches, loads inputs and computes payslips. Does not confirm: confirmed payslips and closed batches are out of reach.</field>
    </record>

    <!-- Approver: slots the preparer under the stock Officer. -->
    <record id="payroll.group_payroll_user" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_payroll_preparer'))]"
        />
    </record>

    <!--
    Extra Rights, like account_payment_order's own group: an orthogonal
    add-on assigned by hand, implied by nobody.
  -->
    <record id="group_payroll_payment" model="res.groups">
        <field name="name">Payroll: payments</field>
        <field name="category_id" ref="base.module_category_usability" />
        <field name="implied_ids" eval="[Command.link(ref('group_payroll_reader'))]" />
        <field
            name="comment"
        >Issues the payment orders and files of confirmed batches. Sees the net amounts; does not change payslips.</field>
    </record>
</odoo>
