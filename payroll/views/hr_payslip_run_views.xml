<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- payslip runs -->
    <record id="hr_payslip_run_view_search" model="ir.ui.view">
        <field name="name">hr.payslip.run.search</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <search string="Search Payslip Batches">
                <field name="name" string="Payslip Batches" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="struct_id" />
                <filter
                    string="Open"
                    name="draft"
                    domain="[('state','=','draft')]"
                    help="Payslip batches that are not closed yet"
                />
                <filter
                    string="In Progress"
                    name="progress"
                    domain="[('stage','=','progress')]"
                    help="Payslip batches with payslips left to confirm"
                />
                <filter
                    name="done_filter"
                    string="Closed"
                    domain="[('state','=','close')]"
                    help="Closed Payslip Batches"
                />
                <separator />
                <filter
                    string="Start Date"
                    name="date_start_filter"
                    date="date_start"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Stage"
                        name="group_state"
                        context="{'group_by':'stage'}"
                    />
                    <filter
                        string="Structure"
                        name="group_struct"
                        context="{'group_by':'struct_id'}"
                    />
                    <filter
                        string="Company"
                        name="group_company"
                        groups="base.group_multi_company"
                        context="{'group_by':'company_id'}"
                    />
                    <filter
                        string="Start Date"
                        name="group_date_start"
                        context="{'group_by':'date_start:month'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="hr_payslip_run_view_tree" model="ir.ui.view">
        <field name="name">hr.payslip.run.list</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <list
                decoration-muted="state == 'close'"
                default_order="date_start desc, id desc"
                multi_edit="1"
                sample="1"
            >
                <field name="name" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="struct_id" optional="show" />
                <field name="slip_count" string="Payslips" optional="show" />
                <field name="currency_id" column_invisible="1" />
                <field name="net_total" sum="Net Total" decoration-bf="1" />
                <field
                    name="stage"
                    decoration-muted="stage == 'draft'"
                    decoration-info="stage == 'progress'"
                    decoration-warning="stage == 'confirmed'"
                    decoration-success="stage == 'close'"
                    widget="badge"
                />
                <field name="activity_ids" widget="list_activity" optional="hide" />
                <field name="credit_note" optional="hide" />
                <field name="state" column_invisible="1" />
                <field name="message_needaction" column_invisible="1" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
            </list>
        </field>
    </record>
    <record id="hr_payslip_run_view_kanban" model="ir.ui.view">
        <field name="name">hr.payslip.run.kanban</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                            <div class="row">
                                <div class="col-6">
                                    <strong>
                                        <field name="name" />
                                        <field
                                            name="company_id"
                                            groups="base.group_multi_company"
                                        />
                                    </strong>
                                </div>
                                <div class="col-6">
                                    <span class="float-right badge badge-secondary">
                                        <field name="state" />
                                    </span>
                                </div>
                                <div class="col-12">
                                    <span>
                                        <field name="date_start" />
                                        -
                                        <field name="date_end" />
                                    </span>
                                    <span class="float-right" title="Refund">
                                        <field name="credit_note" widget="boolean" />
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="hr_payslip_run_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.form</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <form string="Payslips Batches">
                <header>
                    <!--
                        A batch is a sequence of steps: generate the payslips,
                        compute them, confirm them, close. Only ONE button is
                        highlighted at a time, the next step; a button that is
                        the next step at one stage and a shortcut at another
                        is declared twice, with complementary conditions.
                    -->
                    <button
                        name="%(action_hr_payslip_by_employees)d"
                        type="action"
                        string="Generate Payslips"
                        class="oe_highlight"
                        invisible="state != 'draft' or slip_count"
                    />
                    <button
                        name="action_confirm_all"
                        type="object"
                        string="Confirm All"
                        invisible="state != 'draft' or not draft_slip_count"
                        help="Compute and confirm every pending payslip in one step."
                    />
                    <button
                        name="action_compute_all"
                        type="object"
                        string="Recompute All"
                        invisible="state != 'draft' or draft_slip_count or not verify_slip_count"
                        help="Compute again the payslips that are not confirmed yet."
                    />
                    <button
                        name="%(action_hr_payslip_by_employees)d"
                        type="action"
                        string="Add Payslips"
                        invisible="state != 'draft' or not slip_count"
                        help="Generate payslips for employees that are not in the batch yet."
                    />
                    <button
                        name="action_compute_all"
                        type="object"
                        string="Compute All"
                        class="oe_highlight"
                        invisible="state != 'draft' or not draft_slip_count"
                        help="Compute every pending payslip. The ones that fail are listed in the notification and in the chatter; the others move on."
                    />
                    <button
                        name="action_confirm_all"
                        type="object"
                        string="Confirm All"
                        class="oe_highlight"
                        invisible="state != 'draft' or draft_slip_count or not verify_slip_count"
                        help="Confirm every computed payslip. The ones that fail are listed in the notification and in the chatter."
                    />
                    <button
                        name="close_payslip_run"
                        type="object"
                        string="Close"
                        invisible="state != 'draft' or stage != 'confirmed'"
                        class="oe_highlight"
                        help="Close the batch: its payslips can no longer be added or changed."
                    />
                    <button
                        string="Set to Draft"
                        name="draft_payslip_run"
                        type="object"
                        invisible="state != 'close'"
                    />
                    <field name="state" invisible="1" />
                    <field name="stage" widget="statusbar" />
                    <field name="draft_slip_count" invisible="1" />
                    <field name="verify_slip_count" invisible="1" />
                </header>
                <div
                    name="empty_batch_help"
                    class="alert alert-info mb-0 rounded-0"
                    role="status"
                    invisible="state != 'draft' or slip_count"
                >
                    <strong>This batch has no payslips yet.</strong>
                    The first step is <strong
                >Generate Payslips</strong>: the wizard proposes
                    every employee with a contract in the period, and the
                    payslips are then computed and confirmed from here.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_payslips"
                            class="oe_stat_button"
                            icon="fa-list-alt"
                            type="object"
                        >
                            <field
                                name="slip_count"
                                widget="statinfo"
                                string="Payslips"
                            />
                        </button>
                        <button
                            name="%(action_get_batch_payslip_lines)d"
                            class="oe_stat_button"
                            icon="fa-money"
                            type="action"
                            string="Payslip Lines"
                            invisible="not slip_count"
                        />
                    </div>
                    <label for="name" class="oe_edit_only" />
                    <h1>
                        <field name="name" readonly="state != 'draft'" />
                    </h1>
                    <group>
                        <group name="period_group">
                            <label for="date_start" string="Period" />
                            <div>
                                <field
                                    name="date_start"
                                    widget="daterange"
                                    class="oe_inline"
                                    options="{'end_date_field': 'date_end'}"
                                    readonly="state != 'draft'"
                                />
                            </div>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group name="other">
                            <field
                                name="struct_id"
                                readonly="state != 'draft'"
                                placeholder="The one of each contract"
                            />
                            <field name="credit_note" readonly="state != 'draft'" />
                            <field name="currency_id" invisible="1" />
                            <field name="net_total" invisible="not slip_count" />
                        </group>
                    </group>
                    <separator string="Payslips" invisible="not slip_count" />
                    <field
                        name="slip_ids"
                        readonly="state != 'draft'"
                        invisible="not slip_count"
                    >
                        <list create="0" delete="0" default_order="employee_id">
                            <field name="number" />
                            <field name="employee_id" />
                            <field name="struct_id" />
                            <field name="date_from" optional="hide" />
                            <field name="date_to" optional="hide" />
                            <field name="currency_id" column_invisible="1" />
                            <field name="net_wage" sum="Net Wage" />
                            <field
                                name="state"
                                widget="badge"
                                decoration-muted="state == 'draft'"
                                decoration-info="state == 'verify'"
                                decoration-success="state == 'done'"
                                decoration-danger="state == 'cancel'"
                            />
                        </list>
                    </field>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="hr_payslip_run_action" model="ir.actions.act_window">
        <field name="name">Payslips Batches</field>
        <field name="res_model">hr.payslip.run</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="hr_payslip_run_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a payslip batch</p>
            <p>
                A batch groups the payslips of a period so they can be generated,
                computed and closed together.
            </p>
        </field>
    </record>
    <menuitem
        action="hr_payslip_run_action"
        id="hr_payslip_run_menu"
        parent="payroll_menu_root"
    />
</odoo>
