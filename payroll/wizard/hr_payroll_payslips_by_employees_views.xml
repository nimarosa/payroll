<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_payslip_by_employees" model="ir.ui.view">
        <field name="name">payroll_payslip_employees</field>
        <field name="model">hr.payslip.employees</field>
        <field name="arch" type="xml">
            <form string="Generate Payslips">
                <field name="payslip_run_id" invisible="1" />
                <div name="generate_help" class="alert alert-info" role="status">
                    <p class="mb-1">
                        The list already holds <strong
                    >every employee with a contract</strong> in the period
                        <strong><field name="date_start" class="d-inline" /> - <field
                        name="date_end"
                        class="d-inline"
                    /></strong>
                        who has no payslip in this batch yet.
                    </p>
                    <p class="mb-0">
                        Remove whoever should not be paid (or add somebody) and click
                        <strong
                    >Generate</strong>: one payslip per employee is created and computed.
                    </p>
                </div>
                <field name="employee_ids" invisible="1" />
                <field name="line_ids" nolabel="1" colspan="4">
                    <list editable="bottom">
                        <field name="employee_id" />
                        <field name="contract_id" />
                        <field name="struct_id" />
                    </list>
                </field>
                <footer>
                    <button
                        string="Generate"
                        name="compute_sheet"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hr_payslip_by_employees" model="ir.actions.act_window">
        <field name="name">Generate Payslips</field>
        <field name="res_model">hr.payslip.employees</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hr_payslip_by_employees" />
        <field name="target">new</field>
    </record>
</odoo>
